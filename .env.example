# No API key required! All YouTube data is fetched via youtubei.js (InnerTube API).
# The following are optional configuration for HTTP/VPS deployment:
# TRANSPORT=http
# PORT=3000
# HOST=0.0.0.0

# NOTE (fork): API_TOKEN is IGNORED by this fork. The server generates and
# owns its endpoint token (file, mode 600; see YT_TOKEN_FILE below) and logs
# it once at first start. Roll it with the auth tool (action "roll").

# Optional: operational limits (defaults shown). Invalid values stop the server at startup.
# YT_INIT_TIMEOUT_MS=15000
# YT_REQUEST_TIMEOUT_MS=20000
# YT_TRANSCRIPT_MAX_BYTES=5000000
# YT_TRANSCRIPT_MAX_SEGMENTS=50000
# YT_TRANSCRIPT_PAGE_MAX_SEGMENTS=500

# Optional: preferred caption languages when a transcript call omits "lang",
# best match first. An auto track in a preferred language outranks a manual
# track in a non-preferred one. Default: "en".
# YT_DEFAULT_LANGS=en,pt-BR

# --- Install mode: anonymous vs client-configured (account playlists) ---
# Anonymous (default): set NONE of the YT_GOOGLE_* variables. Public tools only.
# Client-configured: set CLIENT_ID + SECRET (token optional). Registers the
# account tools; auth itself is a runtime state machine driven by the
# get_auth_status / start_auth / complete_auth / reset_auth tools - an agent
# can guide its user or drive a browser itself. First auth, expiry, and token
# rolls are all covered; see README "Fork: anonymous vs authenticated mode".
# YT_GOOGLE_CLIENT_ID=...
# YT_GOOGLE_CLIENT_SECRET=...
# Optional install-time token (otherwise obtained via start_auth/complete_auth):
# YT_GOOGLE_REFRESH_TOKEN=...
# Where the runtime-acquired token is stored (default ./.youtube-mcp-auth.json, mode 600):
# YT_AUTH_STATE_FILE=/var/lib/youtube-mcp/auth.json

# Feed/notifications (InnerTube, fragile-by-necessity): one-time sign-in via the
# start_feed_auth tool (device code); no env needed. Cleared by reset_auth.
# Where the server-owned endpoint token lives (default ./.youtube-mcp-token, mode 600):
# YT_TOKEN_FILE=/var/lib/youtube-mcp/token
