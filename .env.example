# No API key required! All YouTube data is fetched via youtubei.js (InnerTube API).
# The following are optional configuration for HTTP/VPS deployment:
# TRANSPORT=http
# PORT=3000
# HOST=0.0.0.0

# Optional: Set a secret token to protect your HTTP endpoint.
# If set, all requests must include: Authorization: Bearer <your-token>
# Leave unset for local development (no auth required).
# API_TOKEN=your-secret-token-here

# Optional: operational limits (defaults shown). Invalid values stop the server at startup.
# YT_INIT_TIMEOUT_MS=15000
# YT_REQUEST_TIMEOUT_MS=20000
# YT_TRANSCRIPT_MAX_BYTES=5000000
# YT_TRANSCRIPT_MAX_SEGMENTS=50000
# YT_TRANSCRIPT_PAGE_MAX_SEGMENTS=500

# Optional: preferred caption languages when a transcript call omits "lang",
# best match first. An auto track in a preferred language outranks a manual
# track in a non-preferred one. Default: "en".
# YT_DEFAULT_LANGS=en,pt-BR

# --- Install mode: anonymous vs authenticated (account playlists) ---
# Anonymous (default): set NONE of the three variables. The server exposes 8
# public tools; no account data.
# Authenticated: set ALL THREE. The server additionally exposes list_my_playlists
# and get_my_playlist_videos for the Google account that consented.
# Partial configuration is rejected at startup.
# Obtain the refresh token once with:
#   YT_GOOGLE_CLIENT_ID=... YT_GOOGLE_CLIENT_SECRET=... node scripts/google-oauth-login.mjs
# (requires a Google Cloud project with YouTube Data API v3 enabled and an
# OAuth "Desktop app" client; you consent once with your own account)
# YT_GOOGLE_CLIENT_ID=...
# YT_GOOGLE_CLIENT_SECRET=...
# YT_GOOGLE_REFRESH_TOKEN=...
