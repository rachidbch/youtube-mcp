{
  "name": "@granitebps/youtube-mcp",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "youtube-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "mcpName": "io.github.granitebps/youtube-mcp",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "npm run build && node dist/index.js",
    "dev:http": "npm run build && node dist/index.js --http",
    "check:package": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:release": "node scripts/check-release.mjs && node scripts/check-workflows.mjs",
    "check": "npm test && npm run check:release && npm run check:package && npm run check:install",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "youtube",
    "transcript",
    "captions",
    "model-context-protocol",
    "stdio"
  ],
  "author": "granitebps",
  "license": "ISC",
  "description": "Read YouTube video metadata, transcripts, comments, and search results through MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granitebps/youtube-mcp.git"
  },
  "homepage": "https://github.com/granitebps/youtube-mcp#readme",
  "bugs": {
    "url": "https://github.com/granitebps/youtube-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "youtube-transcript-plus": "^2.0.0",
    "youtubei.js": "18.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
